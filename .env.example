# Backend (apps/backend). Ningún valor es secreto todavía: la persistencia es
# en memoria y no hay autenticación. Ver docs/development.md.

# Puerto HTTP de la API.
PORT=8080

# Persistencia: por ahora solo "memory" (los datos se pierden al reiniciar).
STORAGE_DRIVER=memory

# Carga datos de ejemplo al iniciar (la memoria arranca vacía en cada reinicio).
SEED_DEMO_DATA=true

# Vender sin stock: con "false" la venta falla si no alcanza el stock; con
# "true" la existencia puede quedar negativa.
STOCK_ALLOW_NEGATIVE=false

# Solo si el frontend se sirve desde otro origen que la API. Con el proxy de
# Vite (desarrollo) o un reverse proxy, dejarlo vacío.
CORS_ALLOWED_ORIGIN=

# Frontend (apps/frontend).

# Destino del proxy de Vite para /api en desarrollo.
API_PROXY_TARGET=http://localhost:8080

# Solo si la API vive en otro origen (requiere CORS_ALLOWED_ORIGIN en el
# backend). Vacío = mismo origen.
VITE_API_URL=
